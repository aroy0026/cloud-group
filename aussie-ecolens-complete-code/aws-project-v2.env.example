# Copy this file to aws-project-v2.env and fill in the values.
# Then run:
#   source aws-project-v2.env
#   ./scripts_aws_apply.sh

export PROJECT_NAME="aussie-ecolens-v2"
export AWS_REGION="ap-southeast-2"

# S3 bucket names must be globally unique across all AWS accounts.
export AWS_UPLOAD_BUCKET="aussie-ecolens-v2-uploads-YOURNAME"

# Frontend origin for local demo. Change to HTTPS deployed frontend URL for production.
export FRONTEND_ORIGIN="http://localhost:5173"

# Option A: use a new Cognito user pool/app client for this new resource set.
# Option B: reuse the old Cognito pool/client if you only want new API/S3/Lambda resources.
export COGNITO_USER_POOL_ID="ap-southeast-2_xxxxxxxxx"
export COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# GCP integration.
export GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"
export GCP_PROCESSING_BUCKET="YOUR_GCP_PROCESSING_BUCKET"
export GCP_SECRET_ID="aussie-ecolens-v2-gcp-service-account"
export PUBSUB_TOPIC="projects/YOUR_GCP_PROJECT_ID/topics/media-processing"

# Set after Cloud Run is deployed. Use the /query-file endpoint.
export QUERY_FILE_PROCESSOR_URL="https://YOUR_CLOUD_RUN_URL/query-file"
