# Local development values for the GCP Cloud Run ML processor.
# Do not commit real secrets here.

PROJECT_ID=project-b70b0656-b022-41bd-bc6
REGION=australia-southeast1
SERVICE=aussie-ecolens-processor
REPOSITORY=aussie-ecolens

# Required by the code. For local /query-file tests this can be any existing GCS bucket,
# because /query-file does not persist files.
GCS_BUCKET=aussie-ecolens-processing-project-b70b0656-b022-41bd-bc6

# Model/runtime files inside the container.
MODEL_PATH=/app/model.pt
LABELS_PATH=/app/labels.txt

# Reasonable model threshold for the assignment demo.
# Lower means more detections but more noise. Higher means fewer detections but more precision.
CONFIDENCE_THRESHOLD=0.20

# Flask/gunicorn.
PORT=8080

